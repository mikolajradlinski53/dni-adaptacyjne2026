# Backend formularzy (Apps Script na koncie administracja@samorzad.ue.wroc.pl)
# Ustaw te zmienne w .env.local ORAZ w Vercel (Production i Preview).

# URL wdrożonej aplikacji internetowej Apps Script (kończy się na /exec)
APPS_SCRIPT_URL=

# Wspólny sekret - ten sam ciąg co CONFIG.SEKRET w Code.gs.
# Wygeneruj np.: openssl rand -hex 32
APPS_SCRIPT_SECRET=
